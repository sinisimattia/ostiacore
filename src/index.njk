---
layout: base.njk
title: Home
---

{# ========================================
   HOMEPAGE — edit this HTML however you like
   ======================================== #}

<section class="hero">
  <h1>{% include "logo.njk" %}</h1>
  <p>{{ "home.welcome" | t }}</p>
</section>

<section class="upcoming-events">
  <h2>{{ "home.upcomingShows" | t }}</h2>
  {% set events = collections.events %}
  {% if events.length %}
    <div class="events-grid">
      {% for event in events %}
        <a href="{{ event.url }}" class="event-card">
          {% if event.data.image %}<img src="{{ event.data.image }}" alt="{{ event.data.title }}" class="event-card-cover">{% endif %}
          <div class="event-card-info">
            <time>{{ event.date | dateFormat }}</time>
            <h3>{{ event.data.title }}</h3>
            {% if event.data.venue %}<span class="venue">{{ event.data.venue }}</span>{% endif %}
            {% if event.data.location %}<span class="location">{{ event.data.location }}</span>{% endif %}
          </div>
        </a>
      {% endfor %}
    </div>
  {% else %}
    <p>{{ "home.noShows" | t }}</p>
  {% endif %}
  <a href="/events/" class="btn">{{ "home.allEvents" | t }}</a>
</section>

<section class="latest-news">
  <h2>{{ "home.latestNews" | t }}</h2>
  {% set news = collections.announcements %}
  {% if news.length %}
    {% for post in news.slice(0, 3) %}
      <article class="news-card">
        <time>{{ post.date | dateFormat }}</time>
        <h3><a href="{{ post.url }}">{{ post.data.title }}</a></h3>
        <p>{{ post.data.excerpt or post.templateContent | truncate(120) }}</p>
      </article>
    {% endfor %}
  {% else %}
    <p>{{ "home.noNews" | t }}</p>
  {% endif %}
  <a href="/announcements/" class="btn">{{ "home.allNews" | t }}</a>
</section>
