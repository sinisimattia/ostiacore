---
layout: base.njk
---

{# ========================================
   HOMEPAGE — edit this HTML however you like
   ======================================== #}
<section class="hero"{% if site.heroBackground %} style="background-image: url('{{ site.heroBackground }}');"{% endif %}>
    <div class="hero-inner">
        <h1>{% include "logo.njk" %}</h1>
        <p>{{ site.description }}</p>
    </div>
</section>
<script>
    (function () {
        const hero = document.querySelector('.hero');
        const inner = document.querySelector('.hero-inner');
        if (!inner || window.matchMedia('(prefers-reduced-motion: reduce)').matches) return;
        window.addEventListener('scroll', function () {
            const rect = hero.getBoundingClientRect();
            if (rect.bottom > 0 && rect.top < window.innerHeight) {
                inner.style.transform = 'translateY(' + (window.scrollY * 0.4) + 'px)';
            }
        }, { passive: true });
    })();
</script>
<section class="upcoming-events">
    <h2>{{ "home.upcomingShows" | t }}</h2>
    {% set events = collections.upcomingEvents %}
    {% if events.length %}
        <div class="events-grid">
            {% for event in events %}
                {% include "event-card.njk" %}
            {% endfor %}
        </div>
        {% else %}
            <p>{{ "home.noShows" | t }}</p>
        {% endif %}
        {% set pastEvents = collections.pastEvents %}
        {% if not pastEvents.length %}
            <a href="/events/" class="btn">{{ "home.allEvents" | t }}</a>
        {% endif %}
    </section>
    {% if pastEvents.length %}
        <section class="past-events">
            <h2>{{ "events.pastShows" | t }}</h2>
            <div class="events-grid">
                {% for event in pastEvents.slice(0, 3) %}
                    {% include "event-card.njk" %}
                {% endfor %}
            </div>
            <a href="/events/" class="btn">{{ "home.allEvents" | t }}</a>
        </section>
    {% endif %}
    <section class="latest-news">
        <h2>{{ "home.latestNews" | t }}</h2>
        {% set news = collections.announcements %}
        {% if news.length %}
            {% for post in news.slice(0, 3) %}
                <article class="news-card">
                    <time>{{ post.date | dateFormat }}</time>
                    <h3>
                        <a href="{{ post.url }}">{{ post.data.title }}</a>
                    </h3>
                    <p>{{ post.data.excerpt or post.templateContent | truncate(120) }}</p>
                </article>
            {% endfor %}
        {% else %}
            <p>{{ "home.noNews" | t }}</p>
        {% endif %}
        <a href="/announcements/" class="btn">{{ "home.allNews" | t }}</a>
    </section>