---
layout: base.njk
title: News
permalink: /announcements/
---

<h1>News</h1>
<div class="news-list">
  {% for post in collections.announcements %}
    <article class="news-card">
      <time>{{ post.date | dateFormat }}</time>
      <h3><a href="{{ post.url }}">{{ post.data.title }}</a></h3>
      <p>{{ post.data.excerpt }}</p>
    </article>
  {% endfor %}
</div>
